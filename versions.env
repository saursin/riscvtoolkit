# Pinned sources of the toolkit. Bump a ref, bump TOOLKIT_VERSION, run the release workflow.
TOOLKIT_VERSION=2026.11

GNU_TOOLCHAIN_REF=2026.10.29        # riscv-gnu-toolchain tag: GCC 16, binutils 2.47, GDB 17, newlib
PICOLIBC_REF=1.8.12
SPIKE_REF=4c6a9bc79dab80616932949707e7c0471d8e9e54     # riscv-isa-sim has no recent tags
PK_REF=9c61d29846d8521d9487a57739330f9682d5b542        # riscv-pk has no recent tags
VERILATOR_REF=v5.052
DTC_REF=v1.8.1
OPENOCD_REF=10b7a647da03cb64fd25db76261712c388ad6468  # riscv-openocd has no recent tags

# Library variants (arch-abi-reuse-): GCC's default --enable-multilib set (the first seven,
# rv64imafdc = rv64gc), plus rv32e* (ilp32e), dedicated rv32ic/rv32imc libraries and rv32gc
# with hard double (ilp32d).
MULTILIBS="rv32i-ilp32--;rv32im-ilp32--;rv32iac-ilp32--;rv32imac-ilp32--;rv32imafc-ilp32f-rv32imafdc-;rv64imac-lp64--;rv64imafdc-lp64d--;rv32e-ilp32e--;rv32ec-ilp32e--;rv32emc-ilp32e--;rv32ic-ilp32--;rv32imc-ilp32--;rv32imafdc-ilp32d--"
